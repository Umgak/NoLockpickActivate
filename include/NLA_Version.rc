#include "NLA_Version.hpp"

1 VERSIONINFO
 FILEVERSION NLA_VERSION_MAJOR,NLA_VERSION_MINOR,NLA_VERSION_PATCH,NLA_VERSION_HOTFIX
 PRODUCTVERSION NLA_VERSION_MAJOR,NLA_VERSION_MINOR,NLA_VERSION_PATCH,NLA_VERSION_HOTFIX
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x0L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Don't automatically activate objects when picking them in Skyrim"
            VALUE "FileVersion", NLA_VERSION_VERSTRING_EX
            VALUE "InternalName", NLA_SHORT_NAME
            VALUE "LegalCopyright", "Copyright (c) 2026"
            VALUE "ProductName", NLA_NAME
            VALUE "ProductVersion", NLA_VERSION_VERSTRING_EX
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
